                    {
                      techStacks.length > 0
                        ? techStacks.slice(0, 6).map((stack) => (
                            <div
                              class="
                                bg-[var(--color-bg)]
                                px-3
                                py-2
                                text-[10px]
                                uppercase
                                truncate
                                text-[var(--color-muted)]
                                hover:bg-[var(--color-red)]
                                hover:text-black
                                transition-colors
                              "
                            >
                              {stack.name}
                            </div>
                          ))
                        : (
                            <div
                              class="
                                col-span-full
                                bg-[var(--color-bg)]
                                px-3
                                py-2
                                text-[10px]
                                text-[var(--color-muted)]
                              "
                            >
                              [NO_STACK_DATA]
                            </div>
                          )
                    }

                  </div>

                </div>

              </div>

            </div>


            <!-- SYSTEM METRICS -->

            <aside
              class="
                flex
                flex-col
                bg-[rgba(255,255,255,0.01)]
              "
            >

              <div
                class="
                  border-b
                  border-[var(--color-border)]
                  px-5
                  py-4
                  text-[10px]
                  uppercase
                  tracking-[0.2em]
                  text-[var(--color-red)]
                "
