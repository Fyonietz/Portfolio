                    [NO_IMAGE_DATA]
                  </div>
                )}

                <div
                  class="
                    absolute
                    inset-0
                    bg-gradient-to-t
                    from-black/70
                    via-transparent
                    to-transparent
                    pointer-events-none
                  "
                ></div>

                <div
                  class="
                    absolute
                    left-3
                    bottom-3
                    text-[9px]
                    uppercase
                    tracking-[0.18em]
                    text-white
                  "
