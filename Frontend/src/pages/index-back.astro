                    text-[var(--color-red)]
                    border
                    border-[var(--color-red)]
                    px-2
                    py-0.5
                  "
                >
                  live
                </span>
              </div>

              <div
                class="
                  relative
                  aspect-square
                  overflow-hidden
                  border
