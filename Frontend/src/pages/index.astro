---
// src/pages/index.astro

import '../styles/global.css';
const API_URL = import.meta.env.PUBLIC_BACKEND || "http://localhost:3000";

let profile = null;
let contacts = [];
let projects = [];
let achievements = [];
let skills = [];
let techStacks = [];

let errorProfile = false;
let errorContacts = false;
let errorProjects = false;
let errorAchievements = false;
let errorSkills = false;
let errorTechStack = false;

// ==============================================
// 1. DATA FETCHING
// ==============================================

// 1. Profile
try {
  const res = await fetch(`${API_URL}/api/v1/profile`);
  if (res.ok) {
    const data = await res.json();
    profile = Array.isArray(data) && data.length > 0 ? data[0] : (data.id ? data : null);
    if (!profile) errorProfile = true;
  } else { errorProfile = true; }
} catch { errorProfile = true; }

// Robust Property Getter (Menangani camelCase ATAU snake_case dari backend .NET)
const pPhoto = profile?.photoUrl || profile?.photo_Url;
const pRole = profile?.roleTitle || profile?.role_Title;
const pBio = profile?.bio;
const pDesc = profile?.description;

// 2. Contacts
try {
  const res = await fetch(`${API_URL}/api/v1/contact`);
  if (res.ok) {
    contacts = await res.json();
    contacts.sort((a, b) => (a.sortOrder || a.sort_Order || 0) - (b.sortOrder || b.sort_Order || 0));
  } else if (res.status !== 404) errorContacts = true;
} catch { errorContacts = true; }

// 3. Skills (BARU: Fetch Data Skill dari API)
try {
  const res = await fetch(`${API_URL}/api/v1/skill`);
  if (res.ok) {
    const data = await res.json();
    // Filter yang dipublish & Sort
    skills = data
      .filter(s => s.published !== false)
      .sort((a, b) => (a.sortOrder || a.sort_Order || 0) - (b.sortOrder || b.sort_Order || 0));
  } else if (res.status !== 404) errorSkills = true;
} catch { errorSkills = true; }

// 3b. Tech Stack
try {
  const res = await fetch(`${API_URL}/api/v1/tech-stack`);
  if (res.ok) {
    const data = await res.json();
    techStacks = Array.isArray(data)
      ? data
          .filter((item) => item && (item.name || item.icon_Url || item.iconUrl))
          .sort((a, b) => (a.sort_Order || a.sortOrder || 0) - (b.sort_Order || b.sortOrder || 0))
      : [];
  } else if (res.status !== 404) errorTechStack = true;
} catch { errorTechStack = true; }

// Kelompokkan skill berdasarkan kategori (otomatis membuat kolom)
const skillsByCategory = skills.reduce((acc, skill) => {
  const cat = (skill.category || 'UNMAPPED').toUpperCase();
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(skill);
  return acc;
}, {});

// 4. Projects
try {
  const res = await fetch(`${API_URL}/api/v1/project`);
  if (res.ok) {
    const data = await res.json();
    projects = data
      .filter((p) => p.published !== false)
      .sort((a, b) => (a.sortOrder || a.sort_Order || 0) - (b.sortOrder || b.sort_Order || 0));
  } else if (res.status !== 404) errorProjects = true;
} catch { errorProjects = true; }

// 5. Achievements (Handle 404 gracefully)
try {
  const res = await fetch(`${API_URL}/api/v1/achievement`);
  if (res.ok) {
    achievements = await res.json();
    achievements.sort((a, b) => (a.sortOrder || a.sort_Order || 0) - (b.sortOrder || b.sort_Order || 0));
  } else if (res.status !== 404) {
    errorAchievements = true;
  }
} catch { errorAchievements = true; }
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile ? profile.name : 'Terminal'} | Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet" />
    <style is:global>
      .animate-blink { animation: blink 1s step-end infinite; }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    </style>
  </head>
  <body class="text-[14px] leading-[1.7] selection:bg-[var(--color-red)] selection:text-black">
    
    <main class="max-w-5xl mx-auto border-x border-[var(--color-border)] flex flex-col bg-[var(--color-bg)]">
      
      <!-- ==============================================
           1. HERO & PROFILE COMBINED SECTION
           ============================================== -->
      <section class="terminal-panel relative min-h-screen flex flex-col justify-center border-b border-[var(--color-border)] p-[1.25rem] md:p-[2rem] lg:p-[3rem] overflow-hidden">
        <div class="absolute inset-0 micro-grid opacity-60 pointer-events-none"></div>
        <div class="absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,rgba(230,57,70,0.65),transparent)]"></div>
        <div class="absolute -left-16 top-10 h-52 w-52 rounded-full bg-[rgba(230,57,70,0.08)] blur-3xl"></div>
        <div class="absolute right-0 bottom-0 h-80 w-80 rounded-full bg-[rgba(230,57,70,0.06)] blur-3xl"></div>

        <div class="relative z-10 w-full max-w-5xl mx-auto flex flex-col gap-6">
          <div class="terminal-header">
            <div class="flex items-center gap-3">
              <div class="terminal-dots">
                <span></span><span></span><span></span>
              </div>
              <div><span class="text-[var(--color-red)]">sys@portfolio</span>:/workspace/landing</div>
            </div>
            <div class="hidden md:flex items-center gap-2">
              <span class="status-flash inline-block w-2 h-2 rounded-full bg-[var(--color-red)]"></span>
              <span>{profile?.status || 'ONLINE'}</span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-8 lg:gap-12 items-center">
            <div class="relative group">
              <div class="signal-badge">live</div>
              <div class="profile-stage terminal-glow">
                {pPhoto ? (
                  <img
                    src={pPhoto.startsWith('/') ? `${API_URL}${pPhoto}` : pPhoto}
                    alt={profile?.name || 'Profile'}
                    class="profile-image w-full aspect-square object-cover border border-[var(--color-border)]"
                  />
                ) : (
                  <div class="w-full aspect-square bg-[var(--color-bg)] flex items-center justify-center text-[var(--color-muted)] text-[11px] border border-[var(--color-border)]">
                    [NO_IMAGE_DATA]
                  </div>
                )}
              </div>

              <div class="floating-tag tag-one">{pRole || 'PROFILE'}</div>
              <div class="floating-tag tag-two">{skills.length || 0} skills</div>
              <div class="floating-tag tag-three">{projects.length || 0} projects</div>
            </div>

            <div class="flex flex-col justify-center">
              <div class="text-[var(--color-muted)] text-[12px] mb-3 flex items-center gap-2 uppercase tracking-[0.25em]">
                <span class="text-[var(--color-red)]">></span> user_authenticated: <span class="text-[var(--color-white)] font-bold">root</span>
              </div>

              <h1 class="text-[32px] md:text-[52px] tracking-[3px] uppercase mb-3 flex items-center leading-none font-bold text-[var(--color-white)]">
                {profile ? profile.name : 'GUEST'}
                <span class="inline-block w-[14px] h-[36px] md:h-[44px] bg-[var(--color-red)] ml-3 animate-blink"></span>
              </h1>

              <div class="flex items-center gap-3 mb-5">
                <span class="terminal-chip inline-flex items-center px-2.5 py-1.5 text-[10px] uppercase tracking-[0.2em] rounded-sm">
                  role // {pRole || 'PROFILE'}
                </span>
              </div>

              <div class="border-l-2 border-[var(--color-red)] pl-4 py-1 mb-7">
                <p class="text-[var(--color-white)] text-[14px] md:text-[15px] leading-[1.8] font-normal">
                  {pDesc || pBio || 'Portfolio data is currently unavailable.'}
                </p>
              </div>

              <div class="flex flex-wrap items-center gap-4 mb-8">
                <a href="#projects" class="border border-[var(--color-red)] bg-[var(--color-red)] text-black px-[22px] py-[11px] text-[13px] rounded-[2px] hover:bg-transparent hover:text-[var(--color-red)] transition-all uppercase leading-[1] font-bold tracking-wider shadow-[0_0_20px_rgba(230,57,70,0.25)]">
                  ./view_projects
                </a>
                <a href="#contact" class="terminal-link px-[22px] py-[11px] text-[13px] rounded-[2px] uppercase leading-[1] tracking-wider">
                  ./contact
                </a>
              </div>

              <div class="flex flex-wrap items-center gap-3 text-[10px] uppercase tracking-[0.2em] text-[var(--color-muted)]">
                <span>stack:</span>
                {techStacks.length > 0 ? techStacks.slice(0, 6).map((stack) => (
                  <span class="border border-[var(--color-border)] px-2 py-1">{stack.name}</span>
                )) : (
                  <span class="border border-[var(--color-border)] px-2 py-1">[no stack data]</span>
                )}
              </div>
            </div>
          </div>

          <div class="supportive-note rounded-[2px] p-4 md:p-5 text-[12px] md:text-[13px] text-[var(--color-white)] leading-[1.8]">
            <p>{pBio || pDesc || 'Data synced from the API.'}</p>
          </div>
        </div>
      </section>

<!-- ==============================================
           2. SKILLS SECTION (DYNAMIC FROM API)
           ============================================== -->
      <section id="skills" class="capability-shell min-h-[68vh] flex flex-col justify-center border-b border-[var(--color-border)] p-[1.5rem] md:p-[2rem]">
        <div class="text-[var(--color-red)] text-[11px] uppercase tracking-[2px] mb-8">// SYSTEM CAPABILITIES</div>

        <div class="capability-grid">
          <div class="terminal-panel-card">
            <div class="terminal-card-header">
              <span class="title">Skills</span>
            </div>

            {errorSkills || skills.length === 0 ? (
              <div class="text-[var(--color-muted)] text-[12px]">> NO SKILLS DATA FOUND.</div>
            ) : (
              <div class="skill-list">
                {skills.slice(0, 3).map((skill) => (
                  <div class="skill-item">
                    <div class="skill-meta">
                      <div class="skill-name">{skill.name}</div>
                      {skill.level !== undefined && <div class="skill-level">{skill.level}%</div>}
                    </div>
                    <div class="skill-bar">
                      <span style={`width: ${skill.level || 0}%`}></span>
                    </div>
                    {skill.description && <div class="skill-desc">{skill.description}</div>}
                  </div>
                ))}
              </div>
            )}
          </div>

          <div class="terminal-panel-card">
            <div class="terminal-card-header">
              <span class="title">Tech Stack</span>
            </div>

            {errorTechStack || techStacks.length === 0 ? (
              <div class="text-[var(--color-muted)] text-[12px]">> NO STACK DATA FOUND.</div>
            ) : (
              <div class="tech-grid">
                {techStacks.slice(0, 4).map((stack) => {
                  const iconUrl = stack.icon_Url || stack.iconUrl;
                  return (
                    <div class="tech-item">
                      {iconUrl ? (
                        <img
                          src={iconUrl.startsWith('/') ? `${API_URL}${iconUrl}` : iconUrl}
                          alt={stack.name}
                          class="object-contain grayscale"
                        />
                      ) : (
                        <div class="w-8 h-8 border border-[var(--color-border)] flex items-center justify-center text-[10px] text-[var(--color-muted)]">{stack.name.slice(0, 2).toUpperCase()}</div>
                      )}
                      <div class="label">{stack.name}</div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          <div id="contact" class="terminal-panel-card">
            <div class="terminal-card-header">
              <span class="title">Contact</span>
            </div>

            {contacts.length === 0 ? (
              <div class="text-[var(--color-muted)] text-[12px]">> NO CONTACT LINKS FOUND.</div>
            ) : (
              <div class="contact-list">
                {contacts.map((c) => (
                  <a
                    href={c.value}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="contact-link"
                  >
                    <span>{c.platform}</span>
                    <span class="arrow">›</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- ==============================================
           3. PROJECTS SECTION
           ============================================== -->
      <section id="projects" class="min-h-screen flex flex-col justify-center border-b border-[var(--color-border)] p-[2rem]">
        <div class="text-[var(--color-red)] text-[11px] uppercase tracking-[2px] mb-4">// EXECUTABLE MODULES</div>
        
        {errorProjects ? (
          <div class="text-[var(--color-muted)] p-[1.75rem] border border-[var(--color-border)] text-center">> ERROR: FAILED TO FETCH PROJECTS DATA.</div>
        ) : projects.length === 0 ? (
          <div class="text-[var(--color-muted)] p-[1.75rem] border border-[var(--color-border)] text-center">> NO ACTIVE PROJECTS FOUND.</div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[1px] bg-[var(--color-border)] border border-[var(--color-border)]">
            {projects.map((p) => {
              const firstPhoto = p.photos ? p.photos.split(',')[0].trim() : null;
              
              // Handle techStack based on Contract (array of objects) OR Fallback ke string comma-separated
              let techList = [];
              if (p.techStacks && Array.isArray(p.techStacks)) {
                techList = p.techStacks.map(t => t.name);
              } else if (p.tech_Stack) {
                techList = p.tech_Stack.split(',').map(t => t.trim());
              }
              
              const desc = p.shortDescription || p.short_Description;

              return (
                <div class="bg-[var(--color-surface)] flex flex-col hover:bg-[#1a1a1a] transition-colors p-[1.75rem]">
                  {firstPhoto ? (
                    <div class="border border-[var(--color-border)] mb-5 h-[160px] overflow-hidden rounded-[2px]">
                      <img src={firstPhoto.startsWith('/') ? `${API_URL}${firstPhoto}` : firstPhoto} alt={p.title} class="w-full h-full object-cover grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300" />
                    </div>
                  ) : (
                    <div class="border border-dashed border-[var(--color-border)] mb-5 h-[160px] rounded-[2px] flex items-center justify-center text-[var(--color-muted)] text-[11px]">[NO_IMG]</div>
                  )}
                  
                  <div class="flex flex-wrap gap-2 mb-4">
                    {techList.map((tech) => (
                      <span class="bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-red)] text-[11px] px-[8px] py-[3px] rounded-[1px] uppercase leading-[1]">{tech}</span>
                    ))}
                  </div>
                  
                  <h3 class="text-[16px] uppercase mb-3 truncate font-bold text-[var(--color-white)]" title={p.title}>{p.title}</h3>
                  <p class="text-[var(--color-white)] text-[14px] leading-[1.8] mb-8 flex-grow line-clamp-3">{desc}</p>
                  
                  <div class="mt-auto pt-4 border-t border-[var(--color-border)] flex justify-between items-center">
                    <a href={`/projects/${p.slug}`} class="text-[var(--color-red)] text-[13px] hover:underline leading-[1]">[ VIEW_DETAILS ]</a>
                  </div>
                </div>
              )
            })}
          </div>
        )}
      </section>

<!-- ==============================================
           5. ACHIEVEMENTS
           ============================================== -->
      <section class="min-h-[80vh] flex flex-col justify-center p-[2rem] bg-[var(--color-surface)]">
        <div class="text-[var(--color-red)] text-[11px] uppercase tracking-[2px] mb-4">// SYSTEM LOGS: ACHIEVEMENTS</div>
        
        {errorAchievements || achievements.length === 0 ? (
           <div class="text-[var(--color-muted)] p-[1.75rem] border border-[var(--color-border)] text-center">
             > NO RECORDS FOUND.
           </div>
        ) : (
          <div class="flex flex-col border border-[var(--color-border)] rounded-[2px] bg-[var(--color-bg)]">
            {achievements.map((ach, index) => {
              const achievedAt = ach.achievedAt || ach.achieved_At;
              const photoUrl = ach.photoUrl || ach.photo_Url;
              
              return (
                <div class={`p-[1.75rem] flex flex-col md:flex-row gap-5 md:gap-10 hover:bg-[#1a1a1a] transition-colors ${index !== achievements.length - 1 ? 'border-b border-[var(--color-border)]' : ''}`}>
                  
                  {/* Kolom Kiri: Tanggal (dan Foto jika ada) */}
                  <div class="md:w-[140px] shrink-0 flex flex-col gap-3">
                    <div class="text-[var(--color-muted)] text-[13px] font-bold leading-[1.7] mt-1 border-b border-[var(--color-border)] pb-2">
                      {achievedAt ? new Date(achievedAt).toLocaleDateString('en-CA') : 'UNKNOWN_DATE'}
                    </div>
                    {photoUrl && (
                      <div class="border border-[var(--color-border)] p-1 bg-[var(--color-surface)] w-full max-w-[140px] aspect-video">
                        <img 
                          src={photoUrl.startsWith('/') ? `${API_URL}${photoUrl}` : photoUrl} 
                          alt={ach.title} 
                          class="w-full h-full object-cover grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                        />
                      </div>
                    )}
                  </div>

                  {/* Kolom Kanan: Detail Konten */}
                  <div class="flex flex-col flex-1">
                    <h4 class="text-[var(--color-white)] text-[16px] uppercase mb-1 font-bold">{ach.title}</h4>
                    {ach.slug && (
                      <div class="text-[var(--color-muted)] text-[11px] uppercase tracking-widest font-mono mb-3">
                        [ID: {ach.slug}]
                      </div>
                    )}
                    <p class="text-[var(--color-white)] text-[14px] leading-[1.8] whitespace-pre-wrap line-clamp-3 mb-4">
                      {ach.description}
                    </p>
                    
                    {/* TOMBOL KLIK KE HALAMAN DETAIL */}
                    <div class="mt-auto pt-4 border-t border-[var(--color-border)] flex justify-between items-center">
                      <a href={`/achievement/${ach.slug}`} class="text-[var(--color-red)] text-[13px] hover:underline leading-[1] font-bold tracking-wider">
                        [ READ_LOG ]
                      </a>
                    </div>
                  </div>

                </div>
              )
            })}
          </div>
        )}
      </section>
      
    </main>
  </body>
</html>
