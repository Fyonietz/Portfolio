                system.metrics
              </div>

              <div
                class="
                  grid
                  grid-cols-2
                  xl:grid-cols-1
                  flex-1
                "
              >

                <div
                  class="
                    border-b
                    xl:border-b
                    border-r
                    xl:border-r-0
                    border-[var(--color-border)]
                    p-5
                    hover:bg-[rgba(230,57,70,0.04)]
                    transition-colors
                  "
                >
                  <div
                    class="
                      text-[9px]
                      uppercase
                      tracking-[0.2em]
                      text-[var(--color-muted)]
                    "
                  >
                    projects
                  </div>

                  <div
                    class="
                      mt-2
                      text-4xl
                      font-bold
                      text-white
                    "
                  >
                    {String(totalProjects).padStart(2, '0')}
                  </div>

                  <div
                    class="
                      mt-1
                      text-[9px]
                      uppercase
                      text-[var(--color-red)]
                    "
                  >
                    executable_modules
                  </div>
                </div>


                <div
                  class="
                    border-b
                    xl:border-b
                    border-[var(--color-border)]
                    p-5
                    hover:bg-[rgba(230,57,70,0.04)]
                    transition-colors
                  "
                >
                  <div
                    class="
                      text-[9px]
                      uppercase
                      tracking-[0.2em]
                      text-[var(--color-muted)]
                    "
                  >
                    skills
                  </div>

                  <div
                    class="
                      mt-2
                      text-4xl
                      font-bold
                      text-white
                    "
                  >
                    {String(totalSkills).padStart(2, '0')}
                  </div>

                  <div
                    class="
                      mt-1
                      text-[9px]
                      uppercase
                      text-[var(--color-red)]
                    "
                  >
                    loaded_capabilities
                  </div>
                </div>


                <div
                  class="
                    border-r
                    xl:border-r-0
                    border-[var(--color-border)]
                    p-5
                    hover:bg-[rgba(230,57,70,0.04)]
                    transition-colors
                  "
                >
                  <div
                    class="
                      text-[9px]
