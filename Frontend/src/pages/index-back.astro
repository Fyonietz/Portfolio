        z-0
      "
    ></div>

    <div
      class="
        fixed
        inset-x-0
        top-0
        h-px
        bg-gradient-to-r
        from-transparent
        via-[var(--color-red)]
        to-transparent
        opacity-40
        pointer-events-none
        z-50
      "
    ></div>

    <main
      class="
        relative
        z-10
        w-full
        max-w-[1500px]
        mx-auto
        min-h-screen
        border-x
        border-[var(--color-border)]
        bg-[var(--color-bg)]
        shadow-[0_0_80px_rgba(0,0,0,0.35)]
      "
    >

      <!-- =====================================================
           TERMINAL TOP BAR
           ===================================================== -->

      <header
        class="
          sticky
          top-0
          z-40
          border-b
          border-[var(--color-border)]
          bg-[rgba(10,10,10,0.94)]
          backdrop-blur-md
        "
      >
        <div
          class="
            flex
            min-h-[48px]
            items-center
            justify-between
            gap-4
            px-4
            md:px-6
            overflow-x-auto
          "
        >

          <div class="flex items-center gap-3 shrink-0">

            <div class="flex gap-1.5">
              <span
                class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"
              ></span>

              <span
                class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"
              ></span>

              <span
                class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"
              ></span>
            </div>

            <div
              class="
                hidden
                sm:block
                text-[11px]
                uppercase
                tracking-[0.18em]
                text-[var(--color-muted)]
              "
            >
              sys@portfolio
            </div>

            <span class="text-[var(--color-border)]">/</span>

            <span
              class="
                text-[11px]
                uppercase
                tracking-[0.18em]
                text-[var(--color-red)]
              "
