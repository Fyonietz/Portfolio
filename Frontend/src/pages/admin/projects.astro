---
import AdminLayout from '../../layouts/AdminLayout.astro'
---

<AdminLayout>
  <div id="main-view" class="flex flex-col h-full">
    <div class="section-header flex items-center justify-between">
      <div>// admin > projects <span class="inline-block w-[6px] h-[10px] bg-[var(--color-red)] animate-blink align-text-bottom ml-1"></span></div>
      <button id="btn-open-add" class="btn-outline">[INS] ADD PROJECT</button>
    </div>

    <div class="px-8 pt-6">
      <input type="text" id="search-input" placeholder="> SEARCH PROJECT TITLE..." class="input" />
    </div>

    <div class="px-8 pt-6 flex-1 overflow-y-auto">
      <table class="tui-table">
        <thead>
          <tr>
            <th>TITLE</th>
            <th>TECH STACK</th>
            <th>STATUS</th>
            <th>ACTIONS</th>
          </tr>
        </thead>
        <tbody id="project-tbody">
          <tr><td colspan="4" class="tui-empty">LOADING...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- MODAL ADD -->
  <div id="modal-add" class="fixed inset-0 z-[100] p-8 flex hidden items-center justify-center bg-[rgba(17,17,17,0.95)]">
    <div class="card w-full max-w-[800px] max-h-[90vh] overflow-y-auto p-6">
      <div class="section-header flex items-center justify-between mb-6">
        <div>// new project <span class="inline-block w-[6px] h-[10px] bg-[var(--color-red)] animate-blink align-text-bottom ml-1"></span></div>
        <button id="btn-close-add" class="bg-transparent border-0 text-muted text-[10px] cursor-pointer hover:text-[var(--color-red)]">[ESC] CLOSE</button>
      </div>
      <form id="form-add" autocomplete="off">
        <div class="tui-form-grid">
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">TITLE</label>
            <input type="text" name="title" required placeholder="Project Name" class="input" />
          </div>
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">SLUG</label>
            <input type="text" name="slug" required placeholder="project-name" class="input" />
          </div>
        </div>
        <div class="flex flex-col mb-3">
          <label class="text-[10px] text-muted mb-1 tracking-[1px]">SHORT DESCRIPTION</label>
          <input type="text" name="short_desc" required placeholder="Brief summary..." class="input" />
        </div>
        <div class="flex flex-col mb-3">
          <label class="text-[10px] text-muted mb-1 tracking-[1px]">FULL DESCRIPTION</label>
          <textarea name="full_desc" rows="4" placeholder="Detailed explanation..." class="input"></textarea>
        </div>
        <div class="tui-form-grid">
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">REPO URL</label>
            <input type="url" name="repo_url" placeholder="https://github.com/..." class="input" />
          </div>
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">DEMO URL</label>
            <input type="url" name="demo_url" placeholder="https://..." class="input" />
          </div>
        </div>
        <div class="tui-form-grid">
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">SORT ORDER</label>
            <input type="number" name="sort_order" value="0" class="input" />
          </div>
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">PUBLISHED</label>
            <div class="flex items-center gap-2 mt-2">
              <input type="checkbox" name="published" checked />
              <span class="text-[11px] text-muted">centang untuk publish</span>
            </div>
          </div>
        </div>
        <div class="flex flex-col mb-3">
          <label class="text-[10px] text-muted mb-1 tracking-[1px]">TECH STACK</label>
          <div id="add-techstack-list" class="flex flex-wrap gap-1.5 p-2.5 border border-[var(--color-border)] rounded-[2px] min-h-[42px]"></div>
        </div>
        <div class="flex flex-col mb-3">
          <label class="text-[10px] text-muted mb-1 tracking-[1px]">PHOTOS</label>
          <input type="file" name="photos" multiple accept="image/*" class="bg-transparent border border-dashed border-[var(--color-border)] p-6 text-muted w-full cursor-pointer text-[11px] hover:border-[#444] hover:text-[var(--color-white)]" />
        </div>
        <div class="flex items-center gap-3 mt-6 pt-6 border-t border-[var(--color-border)]">
          <button type="submit" class="btn-outline">[ENTER] SAVE</button>
          <span id="add-status" class="text-[11px] text-[var(--color-red)] hidden"></span>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL EDIT -->
  <div id="modal-edit" class="fixed inset-0 z-[100] p-8 flex hidden items-center justify-center bg-[rgba(17,17,17,0.95)]">
    <div class="card w-full max-w-[800px] max-h-[90vh] overflow-y-auto p-6">
      <div class="section-header flex items-center justify-between mb-6">
        <div>// edit project <span class="inline-block w-[6px] h-[10px] bg-[var(--color-red)] animate-blink align-text-bottom ml-1"></span></div>
        <button id="btn-close-edit" class="bg-transparent border-0 text-muted text-[10px] cursor-pointer hover:text-[var(--color-red)]">[ESC] CLOSE</button>
      </div>
      <form id="form-edit" autocomplete="off">
        <input type="hidden" name="project_id" />
        <div class="tui-form-grid">
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">TITLE</label>
            <input type="text" name="title" required placeholder="Project Name" class="input" />
          </div>
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">SLUG</label>
            <input type="text" name="slug" required placeholder="project-name" class="input" />
          </div>
        </div>
        <div class="flex flex-col mb-3">
          <label class="text-[10px] text-muted mb-1 tracking-[1px]">SHORT DESCRIPTION</label>
          <input type="text" name="short_desc" required placeholder="Brief summary..." class="input" />
        </div>
        <div class="flex flex-col mb-3">
          <label class="text-[10px] text-muted mb-1 tracking-[1px]">FULL DESCRIPTION</label>
          <textarea name="full_desc" rows="4" placeholder="Detailed explanation..." class="input"></textarea>
        </div>
        <div class="tui-form-grid">
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">REPO URL</label>
            <input type="url" name="repo_url" placeholder="https://github.com/..." class="input" />
          </div>
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">DEMO URL</label>
            <input type="url" name="demo_url" placeholder="https://..." class="input" />
          </div>
        </div>
        <div class="tui-form-grid">
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">SORT ORDER</label>
            <input type="number" name="sort_order" value="0" class="input" />
          </div>
          <div class="flex flex-col mb-3">
            <label class="text-[10px] text-muted mb-1 tracking-[1px]">PUBLISHED</label>
            <div class="flex items-center gap-2 mt-2">
              <input type="checkbox" name="published" />
              <span class="text-[11px] text-muted">centang untuk publish</span>
            </div>
          </div>
        </div>
        <div class="flex flex-col mb-3">
          <label class="text-[10px] text-muted mb-1 tracking-[1px]">TECH STACK</label>
          <div id="edit-techstack-list" class="flex flex-wrap gap-1.5 p-2.5 border border-[var(--color-border)] rounded-[2px] min-h-[42px]"></div>
        </div>
        <div class="flex flex-col mb-3">
          <label class="text-[10px] text-muted mb-1 tracking-[1px]">PHOTOS (kosongkan untuk pertahankan foto lama)</label>
          <input type="file" name="photos" multiple accept="image/*" class="bg-transparent border border-dashed border-[var(--color-border)] p-6 text-muted w-full cursor-pointer text-[11px] hover:border-[#444] hover:text-[var(--color-white)]" />
        </div>
        <div class="flex items-center gap-3 mt-6 pt-6 border-t border-[var(--color-border)]">
          <button type="submit" class="btn-outline">[ENTER] UPDATE</button>
          <span id="edit-status" class="text-[11px] text-[var(--color-red)] hidden"></span>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL DETAIL -->
  <div id="modal-detail" class="fixed inset-0 z-[100] p-8 flex hidden items-center justify-center bg-[rgba(17,17,17,0.95)]">
    <div class="card w-full max-w-[800px] max-h-[90vh] overflow-y-auto p-6">
      <div class="section-header flex items-center justify-between mb-6">
        <div>// project detail <span class="inline-block w-[6px] h-[10px] bg-[var(--color-red)] animate-blink align-text-bottom ml-1"></span></div>
        <button id="btn-close-detail" class="bg-transparent border-0 text-muted text-[10px] cursor-pointer hover:text-[var(--color-red)]">[ESC] CLOSE</button>
      </div>
      <div id="detail-content"></div>
    </div>
  </div>
</AdminLayout>

<script>
  const API   = import.meta.env.PUBLIC_BACKEND || "http://localhost:3000";
  const token = () => sessionStorage.getItem("token");

  let projectsData = [];
  let techStackData = [];
  let currentEditId = null;

  // === ELEMENTS ===
  const modalAdd    = document.getElementById('modal-add');
  const modalEdit   = document.getElementById('modal-edit');
  const modalDetail = document.getElementById('modal-detail');
  const formAdd     = document.getElementById('form-add');
  const formEdit    = document.getElementById('form-edit');
  const addStatus   = document.getElementById('add-status');
  const editStatus  = document.getElementById('edit-status');
  const tbody       = document.getElementById('project-tbody');
  const searchInput = document.getElementById('search-input');
  const detailContent = document.getElementById('detail-content');

  // === MODAL ===
  document.getElementById('btn-open-add').addEventListener('click', () => {
    formAdd.reset();
    renderTechChips('add-techstack-list', []);
    modalAdd.classList.remove('hidden');
  });
  document.getElementById('btn-close-add').addEventListener('click',    () => modalAdd.classList.add('hidden'));
  document.getElementById('btn-close-edit').addEventListener('click',   () => modalEdit.classList.add('hidden'));
  document.getElementById('btn-close-detail').addEventListener('click', () => modalDetail.classList.add('hidden'));
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      modalAdd.classList.add('hidden');
      modalEdit.classList.add('hidden');
      modalDetail.classList.add('hidden');
    }
  });

  // === AUTO SLUG ===
  function bindAutoSlug(form) {
    form.title.addEventListener('input', e => {
      form.slug.value = e.target.value
        .toLowerCase().trim()
        .replace(/\s+/g, '-')
        .replace(/[^a-z0-9-]/g, '');
    });
  }
  bindAutoSlug(formAdd);
  bindAutoSlug(formEdit);

  // === TECHSTACK CHIPS ===
  function renderTechChips(containerId, selectedIds = []) {
    const container = document.getElementById(containerId);
    if (!techStackData.length) {
      container.innerHTML = `<span class="text-muted text-[10px]">No tech stack found.</span>`;
      return;
    }
    container.innerHTML = techStackData.map(t => `
      <button type="button"
        class="bg-[#1a1a1a] border border-[var(--color-border)] text-muted text-[10px] px-2.5 py-1 rounded-[1px] cursor-pointer uppercase transition-all hover:border-[#444] hover:text-[var(--color-white)] aria-pressed:bg-[#1e0a0b] aria-pressed:border-[var(--color-red)] aria-pressed:text-[var(--color-red)]"
        aria-pressed="${selectedIds.includes(t.id)}"
        data-id="${t.id}">
        ${t.name}
      </button>
    `).join('');

    container.querySelectorAll('[aria-pressed]').forEach(chip => {
      chip.addEventListener('click', () => {
        const current = chip.getAttribute('aria-pressed') === 'true';
        chip.setAttribute('aria-pressed', current ? 'false' : 'true');
      });
    });
  }

  function getSelectedTechIds(containerId) {
    return [...document.getElementById(containerId)
      .querySelectorAll('[aria-pressed="true"]')]
      .map(c => c.getAttribute('data-id'))
      .join(',');
  }

  // === LOAD TECHSTACK ===
  async function loadTechStack() {
    try {
      const res  = await fetch(`${API}/api/v1/tech-stack`);
      techStackData = await res.json();
    } catch {
      techStackData = [];
    }
  }

  // === LOAD PROJECTS ===
  async function loadProjects() {
    tbody.innerHTML = `<tr><td colspan="4" class="tui-empty">> FETCHING...</td></tr>`;
    try {
      const res = await fetch(`${API}/api/v1/project`);
      if (!res.ok) throw new Error();
      projectsData = await res.json();
      renderTable(projectsData);
    } catch {
      tbody.innerHTML = `<tr><td colspan="4" class="tui-empty text-[var(--color-red)]">> ERROR: FAILED TO LOAD</td></tr>`;
    }
  }

  function renderTable(data) {
    if (!data.length) {
      tbody.innerHTML = `<tr><td colspan="4" class="tui-empty">> NO PROJECTS FOUND.</td></tr>`;
      return;
    }
    tbody.innerHTML = data.map(p => {
      const tags = (p.techStacks ?? []).map(t => `<span class="tag">${t.name}</span>`).join('');
      return `
        <tr>
          <td><strong>${p.title}</strong></td>
          <td>${tags || '<span class="text-muted">-</span>'}</td>
          <td>
            <span class="tag ${p.published ? 'text-[var(--color-white)]' : 'text-muted'}">
              ${p.published ? 'PUBLISHED' : 'DRAFT'}
            </span>
          </td>
          <td>
            <button class="tui-action-btn btn-action" data-action="view"   data-id="${p.id}">[ VIEW ]</button>
            <button class="tui-action-btn btn-action" data-action="edit"   data-id="${p.id}">[ EDIT ]</button>
            <button class="tui-action-btn btn-action hover:bg-[var(--color-red)] hover:text-black hover:border-[var(--color-red)]" data-action="delete" data-id="${p.id}">[ DELETE ]</button>
          </td>
        </tr>`;
    }).join('');
  }

  // === SEARCH ===
  searchInput.addEventListener('input', e => {
    const kw = e.target.value.toLowerCase();
    renderTable(projectsData.filter(p =>
      p.title.toLowerCase().includes(kw) ||
      (p.techStacks ?? []).some(t => t.name.toLowerCase().includes(kw))
    ));
  });

  // === TABLE ACTIONS ===
  tbody.addEventListener('click', async e => {
    if (!e.target.classList.contains('btn-action')) return;
    const action = e.target.getAttribute('data-action');
    const id     = e.target.getAttribute('data-id');

    if (action === 'view')   await openDetail(id);
    if (action === 'edit')   await openEdit(id);
    if (action === 'delete') await deleteProject(id);
  });

  // === VIEW DETAIL ===
  async function openDetail(id) {
    detailContent.innerHTML = `<div class="tui-empty">> LOADING...</div>`;
    modalDetail.classList.remove('hidden');
    try {
      const res  = await fetch(`${API}/api/v1/project/id/${id}`);
      if (!res.ok) throw new Error();
      const d    = await res.json();
      const tags = (d.techStacks ?? []).map(t => `<span class="tag">${t.name}</span>`).join(' ');
      const photos = d.photos
        ? d.photos.split(',').map(p => `<img src="${API}${p.trim()}" class="max-w-full border border-[var(--color-border)] mt-3" />`).join('')
        : '';

      detailContent.innerHTML = `
        <div>
          <div class="grid grid-cols-[150px_1fr] border-b border-[var(--color-border)] py-2 text-xs"><span class="text-muted">TITLE</span><span>${d.title}</span></div>
          <div class="grid grid-cols-[150px_1fr] border-b border-[var(--color-border)] py-2 text-xs"><span class="text-muted">SLUG</span><span>${d.slug}</span></div>
          <div class="grid grid-cols-[150px_1fr] border-b border-[var(--color-border)] py-2 text-xs"><span class="text-muted">STATUS</span><span class="tag">${d.published ? 'PUBLISHED' : 'DRAFT'}</span></div>
          <div class="grid grid-cols-[150px_1fr] border-b border-[var(--color-border)] py-2 text-xs"><span class="text-muted">TECH STACK</span><span>${tags || '-'}</span></div>
          <div class="grid grid-cols-[150px_1fr] border-b border-[var(--color-border)] py-2 text-xs"><span class="text-muted">SORT ORDER</span><span>${d.sort_Order}</span></div>
          <div class="grid grid-cols-[150px_1fr] border-b border-[var(--color-border)] py-2 text-xs">
            <span class="text-muted">LINKS</span>
            <span>
              ${d.repo_Url ? `<a href="${d.repo_Url}" target="_blank" class="text-[var(--color-red)] no-underline hover:underline">[REPO]</a> ` : ''}
              ${d.demo_Url ? `<a href="${d.demo_Url}" target="_blank" class="text-[var(--color-red)] no-underline hover:underline">[DEMO]</a>` : ''}
            </span>
          </div>
          <div class="mt-3 text-muted text-[11px] leading-[1.7]">${d.short_Description || ''}</div>
          <div class="mt-2 text-[11px] leading-[1.7] whitespace-pre-wrap">${d.full_Description || ''}</div>
          ${photos}
        </div>`;
    } catch {
      detailContent.innerHTML = `<div class="tui-empty text-[var(--color-red)]">> ERROR: NOT FOUND</div>`;
    }
  }

  // === EDIT ===
  async function openEdit(id) {
    currentEditId = id;
    formEdit.reset();
    modalEdit.classList.remove('hidden');
    try {
      const res = await fetch(`${API}/api/v1/project/id/${id}`);
      if (!res.ok) throw new Error();
      const d = await res.json();

      formEdit.project_id.value  = d.id;
      formEdit.title.value       = d.title        ?? '';
      formEdit.slug.value        = d.slug         ?? '';
      formEdit.short_desc.value  = d.short_Description ?? '';
      formEdit.full_desc.value   = d.full_Description  ?? '';
      formEdit.repo_url.value    = d.repo_Url     ?? '';
      formEdit.demo_url.value    = d.demo_Url     ?? '';
      formEdit.sort_order.value  = d.sort_Order   ?? 0;
      formEdit.published.checked = d.published;

      const selectedIds = (d.techStacks ?? []).map(t => t.id);
      renderTechChips('edit-techstack-list', selectedIds);
    } catch {
      alert('> ERROR: CANNOT LOAD PROJECT');
      modalEdit.classList.add('hidden');
    }
  }

  // === DELETE ===
  async function deleteProject(id) {
    if (!confirm(`> DELETE PROJECT #${id}?\n> CANNOT BE UNDONE.`)) return;
    try {
      const res = await fetch(`${API}/api/v1/project/${id}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token()}` },
      });
      if (res.ok) loadProjects();
      else alert('> ERROR: DELETE FAILED');
    } catch {
      alert('> ERROR: NETWORK ERROR');
    }
  }

  // === SUBMIT (ADD & EDIT) ===
  async function submitProject(formEl, method, url, statusEl) {
    const fd = new FormData();
    fd.append('Title',             formEl.title.value);
    fd.append('Slug',              formEl.slug.value);
    fd.append('Short_Description', formEl.short_desc.value);
    fd.append('Full_Description',  formEl.full_desc.value);
    fd.append('Repo_Url',          formEl.repo_url.value);
    fd.append('Demo_Url',          formEl.demo_url.value);
    fd.append('Sort_Order',        formEl.sort_order.value);
    fd.append('Published',         formEl.published.checked);

    const containerId = method === 'POST' ? 'add-techstack-list' : 'edit-techstack-list';
    fd.append('TechStack_Ids', getSelectedTechIds(containerId));

    for (const file of formEl.photos.files) fd.append('photos', file);

    statusEl.textContent = '> SAVING...';
    statusEl.classList.remove('hidden');

    try {
      const res = await fetch(url, {
        method,
        headers: { Authorization: `Bearer ${token()}` },
        body: fd,
      });
      if (!res.ok) throw new Error();
      statusEl.textContent = '> SUCCESS';
      statusEl.classList.remove('text-[var(--color-red)]');
      statusEl.classList.add('text-[var(--color-white)]');
      setTimeout(() => {
        modalAdd.classList.add('hidden');
        modalEdit.classList.add('hidden');
        statusEl.classList.add('hidden');
        statusEl.classList.remove('text-[var(--color-white)]');
        statusEl.classList.add('text-[var(--color-red)]');
        loadProjects();
      }, 1200);
    } catch {
      statusEl.textContent = '> ERROR: FAILED';
      setTimeout(() => statusEl.classList.add('hidden'), 3000);
    }
  }

  formAdd.addEventListener('submit', e => {
    e.preventDefault();
    submitProject(e.target, 'POST', `${API}/api/v1/project`, addStatus);
  });

  formEdit.addEventListener('submit', e => {
    e.preventDefault();
    submitProject(e.target, 'PUT', `${API}/api/v1/project/${currentEditId}`, editStatus);
  });

  // === INIT ===
  await loadTechStack();
  loadProjects();
</script>
