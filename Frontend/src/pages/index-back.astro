---
// src/pages/index.astro

import '../styles/global.css';

const API_URL = import.meta.env.PUBLIC_BACKEND || "http://localhost:3000";

let profile = null;
let contacts = [];
let projects = [];
let achievements = [];
let skills = [];
let techStacks = [];

let errorProfile = false;
let errorContacts = false;
let errorProjects = false;
let errorAchievements = false;
let errorSkills = false;
let errorTechStack = false;

// ============================================================
// DATA FETCHING
// ============================================================

try {
  const res = await fetch(`${API_URL}/api/v1/profile`);

  if (res.ok) {
    const data = await res.json();

    profile = Array.isArray(data) && data.length > 0
      ? data[0]
      : (data?.id ? data : null);

    if (!profile) errorProfile = true;
  } else {
    errorProfile = true;
  }
} catch {
  errorProfile = true;
}

const pPhoto = profile?.photoUrl || profile?.photo_Url;
const pRole = profile?.roleTitle || profile?.role_Title;
const pBio = profile?.bio;
const pDesc = profile?.description;

try {
  const res = await fetch(`${API_URL}/api/v1/contact`);

  if (res.ok) {
    contacts = await res.json();

    contacts.sort(
      (a, b) =>
        (a.sortOrder || a.sort_Order || 0) -
        (b.sortOrder || b.sort_Order || 0)
    );
  } else if (res.status !== 404) {
    errorContacts = true;
  }
} catch {
  errorContacts = true;
}

try {
  const res = await fetch(`${API_URL}/api/v1/skill`);

  if (res.ok) {
    const data = await res.json();

    skills = data
      .filter((s) => s.published !== false)
      .sort(
        (a, b) =>
          (a.sortOrder || a.sort_Order || 0) -
          (b.sortOrder || b.sort_Order || 0)
      );
  } else if (res.status !== 404) {
    errorSkills = true;
  }
} catch {
  errorSkills = true;
}

try {
  const res = await fetch(`${API_URL}/api/v1/tech-stack`);

  if (res.ok) {
    const data = await res.json();

    techStacks = Array.isArray(data)
      ? data
          .filter(
            (item) =>
              item &&
              (item.name || item.icon_Url || item.iconUrl)
          )
          .sort(
            (a, b) =>
              (a.sort_Order || a.sortOrder || 0) -
              (b.sort_Order || b.sortOrder || 0)
          )
      : [];
  } else if (res.status !== 404) {
    errorTechStack = true;
  }
} catch {
  errorTechStack = true;
}

const skillsByCategory = skills.reduce((acc, skill) => {
  const cat = (skill.category || 'UNMAPPED').toUpperCase();

  if (!acc[cat]) {
    acc[cat] = [];
  }

  acc[cat].push(skill);

  return acc;
}, {});

const skillCategories = Object.entries(skillsByCategory);

try {
  const res = await fetch(`${API_URL}/api/v1/project`);

  if (res.ok) {
    const data = await res.json();

    projects = data
      .filter((p) => p.published !== false)
      .sort(
        (a, b) =>
          (a.sortOrder || a.sort_Order || 0) -
          (b.sortOrder || b.sort_Order || 0)
      );
  } else if (res.status !== 404) {
    errorProjects = true;
  }
} catch {
  errorProjects = true;
}

try {
  const res = await fetch(`${API_URL}/api/v1/achievement`);

  if (res.ok) {
    achievements = await res.json();

    achievements.sort(
      (a, b) =>
        (a.sortOrder || a.sort_Order || 0) -
        (b.sortOrder || b.sort_Order || 0)
    );
  } else if (res.status !== 404) {
    errorAchievements = true;
  }
} catch {
  errorAchievements = true;
}

const totalSkills = skills.length;
const totalProjects = projects.length;
const totalAchievements = achievements.length;
const totalTech = techStacks.length;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      {profile ? profile.name : 'Terminal'} | Portfolio
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      .animate-blink {
        animation: blink 1s step-end infinite;
      }

      @keyframes blink {
        0%, 100% {
          opacity: 1;
        }

        50% {
          opacity: 0;
        }
      }

      @keyframes scan {
        from {
          transform: translateY(-100%);
        }

        to {
          transform: translateY(100vh);
        }
      }

      .terminal-scanline {
        animation: scan 8s linear infinite;
      }

      @keyframes pulse-ring {
        0% {
          box-shadow: 0 0 0 0 rgba(230, 57, 70, 0.35);
        }

        70% {
          box-shadow: 0 0 0 8px rgba(230, 57, 70, 0);
        }

        100% {
          box-shadow: 0 0 0 0 rgba(230, 57, 70, 0);
        }
      }

      .pulse-ring {
        animation: pulse-ring 2s infinite;
      }

      html {
        scroll-behavior: smooth;
      }

      ::selection {
        background: #e63946;
        color: #000;
      }
    </style>
  </head>

  <body
    class="
      bg-[var(--color-bg)]
      text-[14px]
      leading-[1.7]
      text-[var(--color-white)]
      selection:bg-[var(--color-red)]
      selection:text-black
      overflow-x-hidden
    "
  >

    <!-- =====================================================
         BACKGROUND SYSTEM GRID
         ===================================================== -->

    <div
      class="
        fixed inset-0
        pointer-events-none
        opacity-[0.035]
        bg-[linear-gradient(rgba(255,255,255,0.5)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.5)_1px,transparent_1px)]
