
---
// src/pages/index.astro

import '../styles/global.css';

const API_URL = import.meta.env.PUBLIC_BACKEND || "http://localhost:3000";

let profile = null;
let contacts = [];
let projects = [];
let achievements = [];
let skills = [];
let techStacks = [];

let errorProfile = false;
let errorContacts = false;
let errorProjects = false;
let errorAchievements = false;
let errorSkills = false;
let errorTechStack = false;

// =====================================================
// DATA
// =====================================================

try {
  const res = await fetch(`${API_URL}/api/v1/profile`);

  if (res.ok) {
    const data = await res.json();
    profile = Array.isArray(data)
      ? data[0] || null
      : data?.id
        ? data
        : null;

    if (!profile) errorProfile = true;
  } else {
    errorProfile = true;
  }
} catch {
  errorProfile = true;
}

const pPhoto = profile?.photoUrl || profile?.photo_Url;
const pRole = profile?.roleTitle || profile?.role_Title;
const pBio = profile?.bio;
const pDesc = profile?.description;

try {
  const res = await fetch(`${API_URL}/api/v1/contact`);

  if (res.ok) {
    contacts = await res.json();

    contacts.sort(
      (a, b) =>
        (a.sortOrder || a.sort_Order || 0) -
        (b.sortOrder || b.sort_Order || 0)
    );
  } else if (res.status !== 404) {
    errorContacts = true;
  }
} catch {
  errorContacts = true;
}

try {
  const res = await fetch(`${API_URL}/api/v1/skill`);

  if (res.ok) {
    const data = await res.json();

    skills = data
      .filter((s) => s.published !== false)
      .sort(
        (a, b) =>
          (a.sortOrder || a.sort_Order || 0) -
          (b.sortOrder || b.sort_Order || 0)
      );
  } else if (res.status !== 404) {
    errorSkills = true;
  }
} catch {
  errorSkills = true;
}

try {
  const res = await fetch(`${API_URL}/api/v1/tech-stack`);

  if (res.ok) {
    const data = await res.json();

    techStacks = Array.isArray(data)
      ? data
          .filter(
            (item) =>
              item &&
              (item.name || item.icon_Url || item.iconUrl)
          )
          .sort(
            (a, b) =>
              (a.sort_Order || a.sortOrder || 0) -
              (b.sort_Order || b.sortOrder || 0)
          )
      : [];
  } else if (res.status !== 404) {
    errorTechStack = true;
  }
} catch {
  errorTechStack = true;
}

try {
  const res = await fetch(`${API_URL}/api/v1/project`);

  if (res.ok) {
    const data = await res.json();

    projects = data
      .filter((p) => p.published !== false)
      .sort(
        (a, b) =>
          (a.sortOrder || a.sort_Order || 0) -
          (b.sortOrder || b.sort_Order || 0)
      );
  } else if (res.status !== 404) {
    errorProjects = true;
  }
} catch {
  errorProjects = true;
}

try {
  const res = await fetch(`${API_URL}/api/v1/achievement`);

  if (res.ok) {
    achievements = await res.json();

    achievements.sort(
      (a, b) =>
        (a.sortOrder || a.sort_Order || 0) -
        (b.sortOrder || b.sort_Order || 0)
    );
  } else if (res.status !== 404) {
    errorAchievements = true;
  }
} catch {
  errorAchievements = true;
}

const totalProjects = projects.length;
const totalSkills = skills.length;
const totalTech = techStacks.length;
const totalAchievements = achievements.length;

// =====================================================
// IMAGE URL HELPERS
// =====================================================

// Helper untuk Profil
const getProfileImageUrl = (url) => {
  if (!url) return '';
  if (url.startsWith('http')) return url;
  return url.startsWith('/') ? `${API_URL}${url}` : `${API_URL}/uploads/profile/${url}`;
};

// Helper untuk Tech Stack (karena tech stack juga punya gambar/icon)
const getStackImageUrl = (url) => {
  if (!url) return '';
  if (url.startsWith('http')) return url;
  return url.startsWith('/') ? `${API_URL}${url}` : `${API_URL}/uploads/tech-stack/${url}`;
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      {profile ? profile.name : 'SYSTEM'} // PORTFOLIO
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="
      min-h-screen
      bg-[var(--color-bg)]
      text-[var(--color-white)]
      font-mono
      text-[14px]
      leading-relaxed
      selection:bg-[var(--color-red)]
      selection:text-black
    "
  >

    <!-- =================================================
         GLOBAL BACKGROUND
         ================================================= -->

    <div
      class="
        fixed inset-0
        pointer-events-none
        opacity-40
        bg-[radial-gradient(circle_at_20%_20%,rgba(230,57,70,0.08),transparent_30%),radial-gradient(circle_at_80%_70%,rgba(230,57,70,0.05),transparent_30%)]
      "
    ></div>

    <div
      class="
        fixed inset-0
        pointer-events-none
        opacity-[0.035]
        bg-[linear-gradient(var(--color-white)_1px,transparent_1px),linear-gradient(90deg,var(--color-white)_1px,transparent_1px)]
        bg-[size:32px_32px]
      "
    ></div>


    <main
      class="
        relative
        mx-auto
        min-h-screen
        w-full
        max-w-[1500px]
        border-x
        border-[var(--color-border)]
        bg-[var(--color-bg)]
      "
    >

      <!-- =================================================
           TOP SYSTEM BAR
           ================================================= -->

      <header
        class="
          sticky top-0 z-50
          flex items-center justify-between
          border-b border-[var(--color-border)]
          bg-[rgba(10,10,10,0.92)]
          px-4 py-3
          backdrop-blur-md
        "
      >

        <div class="flex items-center gap-3">

          <div class="flex gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-yellow-500"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-green-500"></span>
          </div>

          <span class="hidden text-[11px] text-[var(--color-muted)] sm:block">
            sys@portfolio
          </span>

          <span class="text-[var(--color-red)]">
            /
          </span>

          <span class="text-[11px]">
            {profile?.name || 'guest'}
          </span>

        </div>


        <nav class="hidden items-center gap-6 text-[10px] uppercase tracking-[0.2em] md:flex">

          <a
            href="#home"
            class="text-[var(--color-muted)] transition hover:text-[var(--color-red)]"
          >
            /home
          </a>

          <a
            href="#skills"
            class="text-[var(--color-muted)] transition hover:text-[var(--color-red)]"
          >
            /skills
          </a>

          <a
            href="#projects"
            class="text-[var(--color-muted)] transition hover:text-[var(--color-red)]"
          >
            /projects
          </a>

          <a
            href="#logs"
            class="text-[var(--color-muted)] transition hover:text-[var(--color-red)]"
          >
            /logs
          </a>

        </nav>


        <div class="flex items-center gap-2 text-[10px]">

          <span
            class="
              h-1.5 w-1.5
              animate-pulse
              rounded-full
              bg-[var(--color-red)]
              shadow-[0_0_10px_var(--color-red)]
            "
          ></span>

          <span class="uppercase text-[var(--color-muted)]">
            {profile?.status || 'ONLINE'}
          </span>

        </div>

      </header>


      <!-- =================================================
           HERO
           ================================================= -->

      <section
        id="home"
        class="
          relative
          grid
          min-h-[calc(100vh-49px)]
          grid-cols-1
          overflow-hidden
          border-b border-[var(--color-border)]
          lg:grid-cols-[1.1fr_0.9fr]
        "
      >

        <!-- LEFT -->

        <div
          class="
            relative
            flex
            flex-col
            justify-between
            border-b
            border-[var(--color-border)]
            p-5
            sm:p-8
            lg:border-b-0
            lg:border-r
            lg:p-12
          "
        >

          <div>

            <div
              class="
                mb-10
                flex
                items-center
                justify-between
                border-b
                border-[var(--color-border)]
                pb-3
                text-[10px]
                uppercase
                tracking-[0.2em]
              "
            >

              <span class="text-[var(--color-red)]">
                // IDENTITY_MODULE
              </span>

              <span class="text-[var(--color-muted)]">
                001
              </span>

            </div>


            <div
              class="
                mb-5
                text-[11px]
                uppercase
                tracking-[0.3em]
                text-[var(--color-muted)]
              "
            >
              &gt; authentication successful
            </div>


            <h1
              class="
                max-w-4xl
                text-5xl
                font-bold
                uppercase
                leading-[0.9]
                tracking-[-0.04em]
                sm:text-7xl
                lg:text-[clamp(4rem,8vw,8rem)]
              "
            >
              {profile?.name || 'GUEST'}
            </h1>


            <div
              class="
                mt-8
                flex
                max-w-2xl
                items-start
                gap-4
              "
            >

              <span
                class="
                  mt-1
                  h-16
                  w-1
                  shrink-0
                  bg-[var(--color-red)]
                  shadow-[0_0_20px_rgba(230,57,70,0.4)]
                "
              ></span>

              <div>

                <div
                  class="
                    mb-2
                    text-[11px]
                    uppercase
                    tracking-[0.25em]
                    text-[var(--color-red)]
                  "
                >
                  {pRole || 'SYSTEM_OPERATOR'}
                </div>

                <p
                  class="
                    text-[14px]
                    leading-8
                    text-[var(--color-muted)]
                    sm:text-[15px]
                  "
                >
                  {pDesc ||
                    pBio ||
                    'Portfolio data is currently unavailable.'}
                </p>

              </div>

            </div>

          </div>


          <!-- TERMINAL COMMAND -->

          <div class="mt-16">

            <div
              class="
                border
                border-[var(--color-border)]
                bg-[var(--color-surface)]
              "
            >

              <div
                class="
                  flex
                  items-center
                  justify-between
                  border-b
                  border-[var(--color-border)]
                  px-4
                  py-2
                  text-[9px]
                  uppercase
                  tracking-[0.2em]
                  text-[var(--color-muted)]
                "
              >
                <span>terminal</span>
                <span>bash</span>
              </div>

              <div class="space-y-3 p-4 text-[12px]">

                <div>
                  <span class="text-[var(--color-red)]">
                    root@portfolio
                  </span>
                  <span class="text-[var(--color-muted)]">
                    :~$
                  </span>
                  <span class="ml-2">
                    ./initialize.sh
                  </span>
                </div>

                <div class="text-[var(--color-muted)]">
                  loading identity...
                </div>

                <div class="text-green-500">
                  ✓ profile loaded
                </div>

                <div class="text-green-500">
                  ✓ {totalProjects} projects mounted
                </div>

                <div class="text-green-500">
                  ✓ {totalSkills} capabilities detected
                </div>

                <div>
                  <span class="text-[var(--color-red)]">
                    ready
                  </span>
                  <span class="animate-pulse ml-1">█</span>
                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- RIGHT IDENTITY PANEL -->

        <div
          class="
            relative
            flex
            flex-col
            justify-between
            bg-[var(--color-surface)]
          "
        >

          <div
            class="
              relative
              flex
              min-h-[420px]
              flex-1
              items-center
              justify-center
              overflow-hidden
              border-b
              border-[var(--color-border)]
              p-8
            "
          >

            <div
              class="
                absolute
                inset-8
                border
                border-dashed
                border-[var(--color-border)]
              "
            ></div>

            <div
              class="
                absolute
                left-8
                top-8
                bg-[var(--color-surface)]
                px-2
                text-[9px]
                uppercase
                tracking-[0.2em]
                text-[var(--color-red)]
              "
            >
              visual_identity
            </div>


            {pPhoto ? (
              <img
                src={pPhoto.startsWith('/')
                  ? `${API_URL}${pPhoto}`
                  : pPhoto}
                alt={profile?.name || 'Profile'}
                class="
                  relative
                  z-10
                  h-[280px]
                  w-[280px]
                  object-cover
                  border
                  border-[var(--color-border)]
                  grayscale
                  transition
                  duration-500
                  hover:grayscale-0
                  hover:scale-[1.03]
                  sm:h-[340px]
                  sm:w-[340px]
                "
              />
            ) : (
              <div
                class="
                  relative
                  z-10
                  flex
                  h-[280px]
                  w-[280px]
                  items-center
                  justify-center
                  border
                  border-[var(--color-border)]
                  text-[10px]
                  text-[var(--color-muted)]
                  sm:h-[340px]
                  sm:w-[340px]
                "
              >
                [NO_IMAGE_DATA]
              </div>
            )}


            <div
              class="
                absolute
                bottom-10
                right-10
                z-20
                border
                border-[var(--color-red)]
                bg-[var(--color-bg)]
                px-3
                py-2
                text-[9px]
                uppercase
                tracking-[0.2em]
                text-[var(--color-red)]
              "
            >
              LIVE
            </div>

          </div>


          <!-- STATS -->

          <div class="grid grid-cols-2 sm:grid-cols-4">

            <div
              class="
                border-r
                border-b
                border-[var(--color-border)]
                p-5
                sm:border-b-0
              "
            >
              <div class="text-[9px] uppercase text-[var(--color-muted)]">
                projects
              </div>

              <div class="mt-2 text-3xl text-[var(--color-red)]">
                {totalProjects.toString().padStart(2, '0')}
              </div>
            </div>


            <div
              class="
                border-b
                border-[var(--color-border)]
                p-5
                sm:border-b-0
                sm:border-r
              "
            >
              <div class="text-[9px] uppercase text-[var(--color-muted)]">
                skills
              </div>

              <div class="mt-2 text-3xl">
                {totalSkills.toString().padStart(2, '0')}
              </div>
            </div>


            <div
              class="
                border-r
                border-[var(--color-border)]
                p-5
              "
            >
              <div class="text-[9px] uppercase text-[var(--color-muted)]">
                stack
              </div>

              <div class="mt-2 text-3xl">
                {totalTech.toString().padStart(2, '0')}
              </div>
            </div>


            <div class="p-5">

              <div class="text-[9px] uppercase text-[var(--color-muted)]">
                records
              </div>

              <div class="mt-2 text-3xl text-[var(--color-red)]">
                {totalAchievements.toString().padStart(2, '0')}
              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- =================================================
           SKILLS
           ================================================= -->

      <section
        id="skills"
        class="
          border-b
          border-[var(--color-border)]
          p-5
          sm:p-8
          lg:p-12
        "
      >

        <div
          class="
            mb-8
            flex
            items-end
            justify-between
            border-b
            border-[var(--color-border)]
            pb-4
          "
        >

          <div>

            <div
              class="
                mb-2
                text-[10px]
                uppercase
                tracking-[0.25em]
                text-[var(--color-red)]
              "
            >
              // MODULE_02
            </div>

            <h2 class="text-2xl font-bold uppercase sm:text-4xl">
              System Capabilities
            </h2>

          </div>

          <span class="hidden text-[10px] text-[var(--color-muted)] sm:block">
            {totalSkills} MODULES
          </span>

        </div>


        <div class="grid gap-px border border-[var(--color-border)] bg-[var(--color-border)] md:grid-cols-2">

          <!-- SKILLS -->

          <div class="bg-[var(--color-bg)] p-6">

            <div class="mb-6 flex items-center justify-between">

              <span class="text-[11px] uppercase tracking-[0.2em]">
                skill_matrix
              </span>

              <span class="text-[9px] text-green-500">
                ONLINE
              </span>

            </div>


            {errorSkills || skills.length === 0 ? (

              <div class="py-12 text-center text-[11px] text-[var(--color-muted)]">
                &gt; NO SKILLS DATA FOUND
              </div>

            ) : (

              <div class="space-y-6">

                {skills.slice(0, 6).map((skill) => (

                  <div class="group">

                    <div class="mb-2 flex justify-between text-[11px] uppercase">

                      <span>
                        {skill.name}
                      </span>

                      <span class="text-[var(--color-red)]">
                        {skill.level || 0}%
                      </span>

                    </div>


                    <div
                      class="
                        h-2
                        overflow-hidden
                        border
                        border-[var(--color-border)]
                        bg-[var(--color-surface)]
                      "
                    >

                      <div
                        class="
                          h-full
                          bg-[var(--color-red)]
                          transition-all
                          duration-700
                          group-hover:shadow-[0_0_12px_rgba(230,57,70,0.7)]
                        "
                        style={`width:${skill.level || 0}%`}
                      ></div>

                    </div>


                    {skill.description && (

                      <p class="mt-2 text-[10px] text-[var(--color-muted)]">
                        {skill.description}
                      </p>

                    )}

                  </div>

                ))}

              </div>

            )}

          </div>


          <!-- TECH STACK -->

          <div class="bg-[var(--color-bg)] p-6">

            <div class="mb-6 flex items-center justify-between">

              <span class="text-[11px] uppercase tracking-[0.2em]">
                installed_stack
              </span>

              <span class="text-[9px] text-[var(--color-muted)]">
                v1.0
              </span>

            </div>


            {errorTechStack || techStacks.length === 0 ? (

              <div class="py-12 text-center text-[11px] text-[var(--color-muted)]">
                &gt; NO STACK DATA FOUND
              </div>

            ) : (

              <div class="grid grid-cols-2 gap-px border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-3">

                {techStacks.slice(0, 9).map((stack) => {

                  const iconUrl =
                    stack.icon_Url || stack.iconUrl;

                  return (

                    <div
                      class="
                        group
                        flex
                        min-h-[110px]
                        flex-col
                        items-center
                        justify-center
                        gap-3
                        bg-[var(--color-bg)]
                        p-4
                        transition
                        hover:bg-[var(--color-surface)]
                      "
                    >

                      {iconUrl ? (

                        <img
                          src={
                            iconUrl.startsWith('/')
                              ? `${API_URL}${iconUrl}`
                              : iconUrl
                          }
                          alt={stack.name}
                          class="
                            h-8
                            w-8
                            object-contain
                            grayscale
                            opacity-60
                            transition
                            group-hover:grayscale-0
                            group-hover:opacity-100
                          "
                        />

                      ) : (

                        <div
                          class="
                            flex
                            h-8
                            w-8
                            items-center
                            justify-center
                            border
                            border-[var(--color-border)]
                            text-[9px]
                            text-[var(--color-muted)]
                          "
                        >
                          {stack.name.slice(0, 2).toUpperCase()}
                        </div>

                      )}

                      <span class="text-[10px] uppercase">
                        {stack.name}
                      </span>

                    </div>

                  );

                })}

              </div>

            )}

          </div>

        </div>

      </section>


      <!-- =================================================
           PROJECTS
           ================================================= -->

      <section
        id="projects"
        class="
          border-b
          border-[var(--color-border)]
          p-5
          sm:p-8
          lg:p-12
        "
      >

        <div class="mb-8 flex items-end justify-between">

          <div>

            <div
              class="
                mb-2
                text-[10px]
                uppercase
                tracking-[0.25em]
                text-[var(--color-red)]
              "
            >
              // MODULE_03
            </div>

            <h2 class="text-2xl font-bold uppercase sm:text-4xl">
              Executable Modules
            </h2>

          </div>

          <span class="text-[10px] text-[var(--color-muted)]">
            {totalProjects} ENTRIES
          </span>

        </div>


        {errorProjects || projects.length === 0 ? (

          <div
            class="
              border
              border-[var(--color-border)]
              p-16
              text-center
              text-[11px]
              text-[var(--color-muted)]
            "
          >
            &gt; NO ACTIVE PROJECTS FOUND
          </div>

        ) : (

          <div
            class="
              grid
              grid-cols-1
              gap-px
              border
              border-[var(--color-border)]
              bg-[var(--color-border)]
              md:grid-cols-2
              xl:grid-cols-3
            "
          >

            {projects.map((project, index) => {

              const firstPhoto = project.photos
                ? project.photos.split(',')[0].trim()
                : null;

              let techList = [];

              if (
                project.techStacks &&
                Array.isArray(project.techStacks)
              ) {
                techList = project.techStacks.map(
                  (t) => t.name
                );
              } else if (project.tech_Stack) {
                techList = project.tech_Stack
                  .split(',')
                  .map((t) => t.trim());
              }

              const desc =
                project.shortDescription ||
                project.short_Description;

              return (

                <article
                  class="
                    group
                    relative
                    flex
                    min-h-[440px]
                    flex-col
                    overflow-hidden
                    bg-[var(--color-surface)]
                    p-5
                    transition
                    duration-300
                    hover:bg-[#171717]
                  "
                >

                  <!-- project number -->

                  <div
                    class="
                      absolute
                      right-4
                      top-4
                      text-[9px]
                      text-[var(--color-muted)]
                    "
                  >
                    {String(index + 1).padStart(2, '0')}
                  </div>


                  <!-- image -->

                  <div
                    class="
                      relative
                      mb-5
                      h-[190px]
                      overflow-hidden
                      border
                      border-[var(--color-border)]
                    "
                  >

                    {firstPhoto ? (

                      <img
                        src={
                          firstPhoto.startsWith('/')
                            ? `${API_URL}${firstPhoto}`
                            : firstPhoto
                        }
                        alt={project.title}
                        class="
                          h-full
                          w-full
                          object-cover
                          grayscale
                          opacity-60
                          transition
                          duration-500
                          group-hover:scale-105
                          group-hover:grayscale-0
                          group-hover:opacity-100
                        "
                      />

                    ) : (

                      <div
                        class="
                          flex
                          h-full
                          items-center
                          justify-center
                          text-[10px]
                          text-[var(--color-muted)]
                        "
                      >
                        [NO_PREVIEW]
                      </div>

                    )}


                    <!-- scan overlay -->

                    <div
                      class="
                        pointer-events-none
                        absolute
                        inset-0
                        bg-[linear-gradient(transparent_50%,rgba(230,57,70,0.05)_50%)]
                        bg-[length:100%_4px]
                        opacity-0
                        transition
                        group-hover:opacity-100
                      "
                    ></div>


                    <div
                      class="
                        absolute
                        bottom-0
                        left-0
                        h-0.5
                        w-0
                        bg-[var(--color-red)]
                        shadow-[0_0_12px_var(--color-red)]
                        transition-all
                        duration-500
                        group-hover:w-full
                      "
                    ></div>

                  </div>


                  <!-- tech -->

                  <div class="mb-4 flex flex-wrap gap-1.5">

                    {techList.slice(0, 4).map((tech) => (

                      <span
                        class="
                          border
                          border-[var(--color-border)]
                          px-2
                          py-1
                          text-[9px]
                          uppercase
                          text-[var(--color-red)]
                        "
                      >
                        {tech}
                      </span>

                    ))}

                  </div>


                  <h3
                    class="
                      mb-3
                      text-lg
                      font-bold
                      uppercase
                      leading-tight
                    "
                  >
                    {project.title}
                  </h3>


                  <p
                    class="
                      mb-6
                      line-clamp-3
                      flex-1
                      text-[12px]
                      leading-7
                      text-[var(--color-muted)]
                    "
                  >
                    {desc || 'No description available.'}
                  </p>


                  <a
                    href={`/projects/${project.slug}`}
                    class="
                      flex
                      items-center
                      justify-between
                      border-t
                      border-[var(--color-border)]
                      pt-4
                      text-[10px]
                      uppercase
                      tracking-[0.15em]
                      text-[var(--color-red)]
                      transition
                      hover:text-[var(--color-white)]
                    "
                  >

                    <span>
                      execute_module
                    </span>

                    <span
                      class="
                        transition-transform
                        group-hover:translate-x-2
                      "
                    >
                      →
                    </span>

                  </a>

                </article>

              );

            })}

          </div>

        )}

      </section>


      <!-- =================================================
           ACHIEVEMENTS / LOG STREAM
           ================================================= -->

      <section
        id="logs"
        class="
          border-b
          border-[var(--color-border)]
          p-5
          sm:p-8
          lg:p-12
        "
      >

        <div class="mb-8">

          <div
            class="
              mb-2
              text-[10px]
              uppercase
              tracking-[0.25em]
              text-[var(--color-red)]
            "
          >
            // MODULE_04
          </div>

          <h2 class="text-2xl font-bold uppercase sm:text-4xl">
            System Logs
          </h2>

        </div>


        {errorAchievements || achievements.length === 0 ? (

          <div
            class="
              border
              border-[var(--color-border)]
              p-16
              text-center
              text-[11px]
              text-[var(--color-muted)]
            "
          >
            &gt; NO RECORDS FOUND
          </div>

        ) : (

          <div
            class="
              relative
              border
              border-[var(--color-border)]
              bg-[var(--color-surface)]
            "
          >

            <!-- vertical line -->

            <div
              class="
                absolute
                bottom-0
                left-[31px]
                top-0
                w-px
                bg-[var(--color-border)]
                md:left-[151px]
              "
            ></div>


            {achievements.map((achievement, index) => {

              const achievedAt =
                achievement.achievedAt ||
                achievement.achieved_At;

              const photoUrl =
                achievement.photoUrl ||
                achievement.photo_Url;

              return (

                <article
                  class="
                    group
                    relative
                    grid
                    grid-cols-[64px_1fr]
                    border-b
                    border-[var(--color-border)]
                    p-5
                    last:border-b-0
                    md:grid-cols-[150px_1fr]
                    md:p-7
                  "
                >

                  <!-- timeline -->

                  <div class="relative">

                    <div
                      class="
                        absolute
                        left-[7px]
                        top-1
                        z-10
                        h-2.5
                        w-2.5
                        rounded-full
                        border
                        border-[var(--color-red)]
                        bg-[var(--color-bg)]
                        transition
                        group-hover:bg-[var(--color-red)]
                        group-hover:shadow-[0_0_12px_var(--color-red)]
                        md:left-[7px]
                      "
                    ></div>

                    <div
                      class="
                        hidden
                        text-[10px]
                        text-[var(--color-muted)]
                        md:block
                      "
                    >
                      {achievedAt
                        ? new Date(achievedAt).toLocaleDateString('en-CA')
                        : 'UNKNOWN'}
                    </div>

                  </div>


                  <!-- content -->

                  <div class="pl-5 md:pl-8">

                    <div class="mb-2 flex flex-wrap items-center gap-3">

                      <h3 class="text-[15px] font-bold uppercase">
                        {achievement.title}
                      </h3>

                      <span
                        class="
                          border
                          border-[var(--color-border)]
                          px-2
                          py-0.5
                          text-[8px]
                          text-[var(--color-red)]
                        "
                      >
                        LOG_{String(index + 1).padStart(3, '0')}
                      </span>

                    </div>


                    {achievement.slug && (

                      <div
                        class="
                          mb-3
                          text-[9px]
                          uppercase
                          tracking-[0.2em]
                          text-[var(--color-muted)]
                        "
                      >
                        {achievement.slug}
                      </div>

                    )}


                    <p
                      class="
                        max-w-3xl
                        text-[12px]
                        leading-7
                        text-[var(--color-muted)]
                      "
                    >
                      {achievement.description}
                    </p>


                    <div class="mt-5 flex items-center justify-between">

                      <a
                        href={`/achievement/${achievement.slug}`}
                        class="
                          text-[10px]
                          uppercase
                          tracking-[0.15em]
                          text-[var(--color-red)]
                          transition
                          hover:tracking-[0.25em]
                        "
                      >
                        [ READ_FULL_LOG ]
                      </a>


                      {photoUrl && (

                        <img
                          src={
                            photoUrl.startsWith('/')
                              ? `${API_URL}${photoUrl}`
                              : photoUrl
                          }
                          alt={achievement.title}
                          class="
                            hidden
                            h-12
                            w-20
                            object-cover
                            border
                            border-[var(--color-border)]
                            grayscale
                            opacity-50
                            transition
                            group-hover:grayscale-0
                            group-hover:opacity-100
                            sm:block
                          "
                        />

                      )}

                    </div>

                  </div>

                </article>

              );

            })}

          </div>

        )}

      </section>


      <!-- =================================================
           CONTACT / FOOTER
           ================================================= -->

      <footer
        id="contact"
        class="
          grid
          grid-cols-1
          gap-px
          bg-[var(--color-border)]
          sm:grid-cols-2
        "
      >

        <div
          class="
            bg-[var(--color-bg)]
            p-8
            lg:p-12
          "
        >

          <div
            class="
              mb-8
              text-[10px]
              uppercase
              tracking-[0.25em]
              text-[var(--color-red)]
            "
          >
            // CONNECTION_INTERFACE
          </div>

          <h2
            class="
              mb-5
              text-3xl
              font-bold
              uppercase
              sm:text-5xl
            "
          >
            Establish<br />
            Connection.
          </h2>

          <p
            class="
              max-w-md
              text-[12px]
              leading-7
              text-[var(--color-muted)]
            "
          >
            Open communication channels detected.
            Select a protocol below to establish contact.
          </p>

        </div>


        <div class="bg-[var(--color-surface)]">

          {contacts.length === 0 ? (

            <div class="p-12 text-[11px] text-[var(--color-muted)]">
              &gt; NO CONNECTIONS AVAILABLE
            </div>

          ) : (

            <div>

              {contacts.map((contact, index) => (

                <a
                  href={contact.value}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="
                    group
                    flex
                    items-center
                    justify-between
                    border-b
                    border-[var(--color-border)]
                    p-6
                    transition
                    hover:bg-[var(--color-bg)]
                  "
                >

                  <div class="flex items-center gap-4">

                    <span
                      class="
                        text-[10px]
                        text-[var(--color-muted)]
                      "
                    >
                      {String(index + 1).padStart(2, '0')}
                    </span>

                    <span
                      class="
                        uppercase
                        tracking-[0.15em]
                        transition
                        group-hover:text-[var(--color-red)]
                      "
                    >
                      {contact.platform}
                    </span>

                  </div>


                  <span
                    class="
                      text-[var(--color-muted)]
                      transition
                      group-hover:translate-x-2
                      group-hover:text-[var(--color-red)]
                    "
                  >
                    →
                  </span>

                </a>

              ))}

            </div>

          )}

        </div>

      </footer>


      <div
        class="
          flex
          flex-col
          justify-between
          gap-2
          border-t
          border-[var(--color-border)]
          px-5
          py-4
          text-[9px]
          uppercase
          tracking-[0.15em]
          text-[var(--color-muted)]
          sm:flex-row
        "
      >

        <span>
          © {new Date().getFullYear()} {profile?.name || 'PORTFOLIO'}
        </span>

        <span>
          SYSTEM_STATUS :: <span class="text-green-500">OPERATIONAL</span>
        </span>

      </div>

    </main>

  </body>
</html>
