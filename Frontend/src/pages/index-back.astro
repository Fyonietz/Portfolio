        <div class="relative">

          <!-- command header -->

          <div
            class="
              flex
              flex-wrap
              items-center
              justify-between
              gap-3
              border-b
              border-[var(--color-border)]
              px-4
              py-3
              md:px-6
              bg-[rgba(255,255,255,0.015)]
